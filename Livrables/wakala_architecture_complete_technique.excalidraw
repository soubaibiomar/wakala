    {
      "id": "kb2t11eEE3Mgll2439CR",
      "type": "text",
      "x": 72,
      "y": 4940,
      "width": 836,
      "height": 113.75,
      "angle": 0,
      "strokeColor": "#5c3c00",
      "backgroundColor": "transparent",
