    },
    {
      "id": "sn0mKtwxu37HW4qAMhbl",
      "type": "text",
      "x": 72,
      "y": 4310,
      "width": 836,
      "height": 130,
      "angle": 0,
      "strokeColor": "#5c3c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
