    {
      "id": "eff5bbc7-8aa1-453a-953f-ea1f22153f16",
      "type": "text",
      "x": 45,
      "y": 7720,
      "width": 968.957275390625,
      "height": 562.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
