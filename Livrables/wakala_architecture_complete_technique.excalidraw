    {
      "id": "213c6611-4440-4b9d-ad06-380743908c6e",
      "type": "text",
      "x": -38,
      "y": 6481,
      "width": 1100.4832763671875,
      "height": 652.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
