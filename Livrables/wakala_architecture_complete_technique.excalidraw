    {
      "id": "tikgh8mHqIyrt8u59mnN",
      "type": "text",
      "x": 72,
      "y": 4730,
      "width": 836,
      "height": 130,
      "angle": 0,
      "strokeColor": "#5c3c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1748227944,
      "versionNonce": 336777404,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785143082781,
      "link": null,
      "locked": false,
      "text": "En g\u00e9n\u00e9ral : chaque annonce scrap\u00e9e (Avito, Moteur.ma, Wandaloo) est analys\u00e9e sur\n3 axes (photos, prix, vendeur) ; un score de fiabilit\u00e9 combin\u00e9 est affich\u00e9 \u00e0 l'acheteur.\n\nBackend : IA d'Analyse d'Images (IA d'Analyse Visuelle) d\u00e9tecte les dommages sur les photos ; une comparaison au march\u00e9\nrep\u00e8re les prix anormalement bas ; Base de Donn\u00e9es de Connexions (Analyse de r\u00e9seau) analyse le graphe vendeur/annonces pour\nd\u00e9tecter des patterns suspects (doublons, comportements anormaux). Les 3 signaux\nsont combin\u00e9s en un score unique, affich\u00e9 en badge sur l'annonce et remont\u00e9 au\nchatbot en cas d'alerte.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 13,
      "containerId": "sYbcN6jzin1QDVVuXuyK",
      "originalText": "En g\u00e9n\u00e9ral : chaque annonce scrap\u00e9e (Avito, Moteur.ma, Wandaloo) est analys\u00e9e sur\n3 axes (photos, prix, vendeur) ; un score de confiance combin\u00e9 est affich\u00e9 \u00e0 l'acheteur.\n\nBackend : IA d'Analyse d'Images (YOLOv8) d\u00e9tecte les dommages sur les photos ; une comparaison au march\u00e9\nrep\u00e8re les prix anormalement bas ; Base de Donn\u00e9es de Connexions (Graphe Neo4j) analyse le graphe vendeur/annonces pour\nd\u00e9tecter des patterns suspects (doublons, comportements anormaux). Les 3 signaux\nsont combin\u00e9s en un score unique, affich\u00e9 en badge sur l'annonce et remont\u00e9 au\nchatbot en cas d'alerte.",
      "lineHeight": 1.25,
      "version": 2,
      "index": "b2S",
      "autoResize": true
    },
