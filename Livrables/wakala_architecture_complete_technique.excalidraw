      "boundElements": [],
      "updated": 1785143082781,
      "link": null,
      "locked": false,
      "text": "En simple : pour chaque partie du sch\u00e9ma ci-dessus, voici le fonctionnement g\u00e9n\u00e9ral et ce qui se passe pr\u00e9cis\u00e9ment c\u00f4t\u00e9 backend.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 13,
      "containerId": null,
      "originalText": "En simple : pour chaque partie du sch\u00e9ma ci-dessus, voici le fonctionnement g\u00e9n\u00e9ral et ce qui se passe pr\u00e9cis\u00e9ment c\u00f4t\u00e9 backend.",
      "lineHeight": 1.25,
      "version": 2,
      "index": "b2J",
      "autoResize": true
    },
