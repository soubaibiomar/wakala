      "text": "PARTIE 1 \u2014 Recherche : vue d'ensemble",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 16,
      "containerId": null,
      "originalText": "PARTIE 1 \u2014 Recherche : vue d'ensemble",
      "lineHeight": 1.25,
      "version": 2,
      "index": "b2K",
      "autoResize": true
    },
    {
      "id": "8A3QkqTlAHySQMaTjstU",
      "type": "rectangle",
      "x": 60,
      "y": 4298,
      "width": 860,
