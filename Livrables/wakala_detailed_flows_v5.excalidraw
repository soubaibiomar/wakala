    {
      "id": "417743a1-4f68-41e4-bf1d-154e5ba5260e",
      "type": "text",
      "x": 20,
      "y": 578,
      "width": 460,
      "height": 200.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
