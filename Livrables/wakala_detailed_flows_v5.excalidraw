    {
      "id": "74c8b585-f352-497d-8d3a-814a2e7c7ece",
      "type": "text",
      "x": 20,
      "y": 1086,
      "width": 460,
      "height": 140.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "32d2e1e0-a55b-4436-848d-e0aba277d153"
      ],
      "strokeSharpness": "sharp",
