      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Architecture Hybride :\n- Collaborative Filtering : Trouve des utilisateurs aux favoris similaires.\n- Content-Based : Suggère des véhicules similaires (marque, prix) à ceux consultés.\n- Résultat : Liste d'IDs de véhicules envoyée au Frontend (Dashboard).",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "Architecture Hybride :\n- Collaborative Filtering : Trouve des utilisateurs aux favoris similaires.\n- Content-Based : Suggère des véhicules similaires (marque, prix) à ceux consultés.\n- Résultat : Liste d'IDs de véhicules envoyée au Frontend (Dashboard).",
      "lineHeight": 1.25
    },
