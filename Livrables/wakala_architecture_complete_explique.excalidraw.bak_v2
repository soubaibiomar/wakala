    },
    {
      "id": "text_txt_det_c_0_p3",
      "type": "text",
      "x": 1650,
      "y": 950,
      "width": 1533,
      "height": 87.5,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 123,
      "version": 2,
      "versionNonce": 205632972,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785263639653,
      "link": null,
      "locked": false,
      "text": "La similarité cosinus (sim = A.B / ||A||\n||B||) mesure l'angle entre le vecteur de\nl'utilisateur (budget, priorités) et celui de\nl'annonce dans l'espace multidimensionnel de\nQdrant. Avantage : prédictible et explicable.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 12,
      "containerId": null,
      "originalText": "La similarité cosinus (sim = A.B / ||A||\n||B||) mesure l'angle entre le vecteur de\nl'utilisateur (budget, priorités) et celui de\nl'annonce dans l'espace multidimensionnel de\nQdrant. Avantage : prédictible et explicable.",
      "index": "b2G",
      "frameId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text_txt_det_t_1_p3",
