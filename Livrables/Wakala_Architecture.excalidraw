    {
      "id": "aa1fa084-9188-4af7-b747-bfa867f7895a",
      "type": "text",
      "x": 330,
      "y": 2170,
      "width": 230,
      "height": 105,
      "strokeColor": "#2b8a3e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
