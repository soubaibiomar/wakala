      "isDeleted": false,
      "boundElements": [],
      "text": "COMMENT CA MARCHE EN DETAILS :",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 18,
      "lineHeight": 1.25,
      "originalText": "COMMENT CA MARCHE EN DETAILS :",
