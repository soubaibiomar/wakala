      "seed": 1,
      "version": 2,
      "versionNonce": 262941549,
      "isDeleted": false,
      "boundElements": [],
      "text": "{\n  \"brands\": [\"audi\", \"bmw\", \"mercedes\"],\n  \"body_type\": [\"sedan\"],\n  \"max_price\": 150000,\n  \"tags\": [\"pas cher\"]\n}",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": "9b84deea-398c-4bc8-b09b-9e230c244cfb",
      "lineHeight": 1.25,
      "originalText": "{\n  \"brands\": [\"audi\", \"bmw\", \"mercedes\"],\n  \"body_type\": [\"sedan\"],\n  \"max_price\": 150000,\n  \"tags\": [\"pas cher\"]\n}",
      "index": "b0f",
