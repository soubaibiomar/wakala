    {
      "id": "90be983e-3ffc-4d21-ad34-acc538ecc383",
      "type": "text",
      "x": 70,
      "y": 3365,
      "width": 1360,
      "height": 40,
      "strokeColor": "#5c3c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
