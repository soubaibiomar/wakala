    },
    {
      "id": "4f4ff957-82e0-4da0-8",
      "type": "text",
      "x": 695,
      "y": 4560,
      "width": 592.8,
      "height": 156.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "0abcef5e-46bf-4c28-b"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 565147942,
      "versionNonce": 1181774351,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785143082781,
      "link": null,
      "locked": false,
      "text": "1. Identifier le Persona de l'utilisateur.\n2. Traverser le graphe Neo4j :\n   (user) -[:AIME]->(V_1)<-[:AIME]- (user2)\n   (user2) -[:A_ACHETE]->(V_Reco)\n3. Pond\u00e9rer par type d'interaction: Sauvegarde (x3) > Clic (x1) > Vue (x0.5)\n4. Pond\u00e9rer par r\u00e9cence.\n\nAvantage: capte les signaux implicites.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 13,
      "containerId": null,
      "originalText": "1. Identifier le Persona de l'utilisateur.\n2. Traverser le graphe Neo4j :\n   (user) -[:AIME]->(V_1)<-[:AIME]- (user2)\n   (user2) -[:A_ACHETE]->(V_Reco)\n3. Pond\u00e9rer par type d'interaction: Sauvegarde (x3) > Clic (x1) > Vue (x0.5)\n4. Pond\u00e9rer par r\u00e9cence.\n\nAvantage: capte les signaux implicites.",
      "lineHeight": 1.25,
      "version": 2,
      "index": "a0",
      "autoResize": true
    },
