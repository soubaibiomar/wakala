      "text": "D\u00e9tail - Contournement, DLQ (Dead Letter Queue) & JSON Schema",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 14,
      "containerId": null,
      "originalText": "D\u00e9tail - Contournement, DLQ (Dead Letter Queue) & JSON Schema",
