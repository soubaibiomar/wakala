      "text": "D\u00e9tail - Embedding et Pipeline Moteur de Recherche Vectoriel",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 14,
      "containerId": null,
      "originalText": "D\u00e9tail - Embedding et Pipeline Moteur de Recherche Vectoriel",
      "lineHeight": 1.25,
