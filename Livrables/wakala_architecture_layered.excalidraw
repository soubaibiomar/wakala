    {
      "id": "9961fc66-b674-4e9d-a",
      "type": "text",
      "x": 196.0,
      "y": 2860,
      "width": 468.0,
      "height": 58.5,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "e6409aa7-52cb-4b09-8"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1057333014,
      "versionNonce": 1571908198,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785143082781,
      "link": null,
      "locked": false,
      "text": "Pr\u00e9-processing: Resize 640x640, Normalize\nUltralytics YOLOv8: D\u00e9tection chocs/rayures\nImageHash: D\u00e9tection d'annonces en double (Hamming Distance)",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
