      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text_txt_det_c_1_p3",
      "type": "text",
      "x": 2050,
      "y": 950,
      "width": 1414,
      "height": 87.5,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 123,
      "version": 2,
      "versionNonce": 278993996,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785263639653,
      "link": null,
      "locked": false,
      "text": "Le score est basé sur la théorie des graphes.\nLes annonces liées aux utilisateurs du même\npersona sont pondérées par le type\nd'interaction (Sauvegarde > Vue) et la\nrécence. Capte les signaux implicites.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 12,
      "containerId": null,
      "originalText": "Le score est basé sur la théorie des graphes.\nLes annonces liées aux utilisateurs du même\npersona sont pondérées par le type\nd'interaction (Sauvegarde > Vue) et la\nrécence. Capte les signaux implicites.",
      "index": "b2I",
      "frameId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text_txt_det_t_2_p3",
      "type": "text",
      "x": 1850,
      "y": 1070,
      "width": 176,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 123,
