      "updated": 1785263639653,
      "link": null,
      "locked": false,
      "text": "Détail Modèle 2 (Collaboratif)",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 14,
      "containerId": null,
      "originalText": "Détail Modèle 2 (Collaboratif)",
