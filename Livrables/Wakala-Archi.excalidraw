      "text": "{\n  \"hard_filters\": {\"budget_max\": 140000, \"places_min\": 5},\n  \"soft_features\": [\"familiale\", \"robuste\"]\n}",
      "originalText": "{\n  \"hard_filters\": {\"budget_max\": 140000, \"places_min\": 5},\n  \"soft_features\": [\"familiale\", \"robuste\"]\n}",
