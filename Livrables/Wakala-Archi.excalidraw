    {
      "id": "457c37390ae94d42bd41",
      "type": "text",
      "x": 1667,
      "y": 1860,
      "width": 500,
      "height": 67.19999999999999,
      "angle": 0,
      "strokeColor": "#a9b7c6",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
