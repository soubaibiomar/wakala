# ═══════════════════════════════════════════════════════════════
# Wakala Backend — Variables d'Environnement (.env.example)
#
# Copier ce fichier vers backend/.env et configurer les valeurs :
#   cp .env.example .env
#
# IMPORTANT PRODUCTION :
# - Définir APP_ENV=production et DEBUG=false
# - Remplacer SECRET_KEY par un secret cryptographique fort (min 32 chars) :
#     python -c "import secrets; print(secrets.token_hex(32))"
# - Ne jamais commiter de vrais secrets ou clés API dans Git.
# ═══════════════════════════════════════════════════════════════

# ─── 1. Core & Sécurité ─────────────────────────────────────────
APP_NAME=Wakala
APP_ENV=production
DEBUG=false

# Clé secrète de signature JWT (OBLIGATOIRE en production)
SECRET_KEY=change-me-to-a-secure-64-character-hex-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Authentification Google OAuth (Optionnel)
GOOGLE_CLIENT_ID=

# Origines autorisées pour CORS (Format JSON strict)
# Ex: ["https://wakala.ma","https://app.wakala.ma"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://wakala-jzdd.vercel.app"]

# Secret de validation des Webhooks de paiement (Escrow / CMI / Stripe)
WEBHOOK_SECRET=your-secure-webhook-secret-token

# ─── 2. Base de Données Relationnelle (PostgreSQL / Neon) ───────
# Option A : URL complète (recommandé pour Neon / Cloud PostgreSQL)
# Si défini, DATABASE_URL est prioritaire sur les champs individuels ci-dessous.
# Ex: postgresql+asyncpg://user:password@ep-xyz.eu-central-1.neon.tech/wakala?sslmode=require
DATABASE_URL=

# Option B : Connexion classique via hôte séparé (Docker Compose ou VPS local)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=wakala_db
POSTGRES_USER=wakala_user
POSTGRES_PASSWORD=replace_with_strong_db_password

# ─── 3. Vector Store (Qdrant) ──────────────────────────────────
# Mode Cloud (Qdrant Cloud) :
# QDRANT_URL=https://your-cluster-id.eu-central.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=your-qdrant-cloud-api-key
QDRANT_URL=
QDRANT_API_KEY=

# Mode Local (Docker Compose / Contabo VPS) :
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=vehicle_embeddings

# ─── 4. Base de Données Graphe (Neo4j) ──────────────────────────
# Pour instances locales ou Neo4j Aura Cloud
# Ex local : bolt://neo4j:7687  |  Ex Aura : neo4j+s://your-instance.databases.neo4j.io
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace_with_strong_neo4j_password

# ─── 5. Cache & Sessions (Redis) ───────────────────────────────
# Utilisé par le rate limiting et la gestion des sessions/OTP
# Ex: redis://redis:6379/0 ou Upstash rediss://default:token@xyz.upstash.io:6379
REDIS_URL=redis://redis:6379/0

# ─── 6. LLM, RAG, Vision & Voice AI ─────────────────────────────
# OpenRouter (Passerelle principale LLM multi-fournisseurs)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free
OPENROUTER_MODELS=["liquid/lfm-2.5-2.6b:free","minimax/minimax-m3:free","openrouter/free"]

# Fournisseurs LLM alternatifs / Fallbacks
OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_MODEL=

# Modèle d'embeddings pour recherche sémantique RAG
EMBEDDING_MODEL=hash-1024

# Hugging Face & Cohere (Optionnel)
HF_TOKEN=
HUGGINGFACE_API_KEY=
COHERE_API_KEY=

# Synthèse vocale ElevenLabs (Côté serveur uniquement)
ELEVENLABS_API_KEY=
TTS_VOICE_FR=
TTS_VOICE_DARIJA=
TTS_VOICE_AR=
TTS_VOICE_EN=
VOICE_MAX_SECONDS=90

# ─── 7. Emails (SMTP) ──────────────────────────────────────────
# Par défaut configuré pour MailHog en local ou SMTP externe (SendGrid, Resend, Brevo)
MAIL_SERVER=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@wakala.ma
MAIL_STARTTLS=false
MAIL_SSL_TLS=false
USE_CREDENTIALS=false
VALIDATE_CERTS=true

# ─── 8. Kafka (Offline / Batch uniquement — Non requis en live) ─
# Ces paramètres sont uniquement lus par les workers batch d'ingestion.
# Si KAFKA_BOOTSTRAP_SERVERS est vide, le backend démarre normalement.
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_API_KEY=
KAFKA_API_SECRET=
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
