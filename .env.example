# ═══════════════════════════════════════════════════════════════
# Wakala — Variables d'environnement
#
# Copier vers .env et personnaliser les valeurs :
#   cp .env.example .env
#
# Les valeurs par défaut ci-dessous sont pour le développement
# local avec docker-compose.
# ═══════════════════════════════════════════════════════════════

# ─── Application ───────────────────────────────────────────────
APP_NAME=Wakala
APP_ENV=development
DEBUG=true

# ─── Sécurité / JWT ───────────────────────────────────────────
# IMPORTANT : Générer une clé unique en production :
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=wakala
POSTGRES_USER=wakala_user
POSTGRES_PASSWORD=wakala_secret_password

# ─── Neo4j (graphe) ──────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_secret_password

# ─── Qdrant (vector store) ───────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=vehicle_embeddings

# ─── Kafka ────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─── LLM / RAG ───────────────────────────────────────────────
# Groq fournit une inference LLM ultra-rapide (>1000 tok/s sur Llama 3).
# Obtenir une cle API gratuite : https://console.groq.com/keys
GROQ_API_KEY=gsk-votre-cle-api-groq-ici
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback OpenAI (si besoin pour d'autres modules)
OPENAI_API_KEY=sk-your-openai-key-here
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
