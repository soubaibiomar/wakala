# ═══════════════════════════════════════════════════════════════
# Wakala — Variables d'environnement
#
# Copier vers .env et personnaliser les valeurs :
#   cp .env.example .env
#
# Les valeurs par défaut ci-dessous sont pour le développement
# local avec docker-compose.
# ═══════════════════════════════════════════════════════════════

# ─── Application ───────────────────────────────────────────────
APP_NAME=Wakala
APP_ENV=development
DEBUG=true

# ─── Sécurité / JWT ───────────────────────────────────────────
# IMPORTANT : Générer une clé unique en production :
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=wakala
POSTGRES_USER=wakala_user
POSTGRES_PASSWORD=wakala_secret_password

# ─── Neo4j (graphe) ──────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_secret_password

# ─── Qdrant (vector store) ───────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=vehicle_embeddings

# ─── Kafka ────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─── LLM / RAG ───────────────────────────────────────────────
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
