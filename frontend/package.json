{
  "name": "wakala-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Wakala — Frontend React 18 + TypeScript pour marketplace automobile IA",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000 --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 3000",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-env": "node -e \"const fs=require('fs'); const src=fs.readFileSync('dist/assets/index.js','utf8')||''; const leaks=['OPENAI_API_KEY','AWS_SECRET','S3_BUCKET'].filter(k=>src.includes(k)); if(leaks.length){console.error('LEAK DETECTED:',leaks);process.exit(1)}else{console.log('No secrets leaked in build.')}\"",
    "security:audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@react-oauth/google": "^0.13.5",
    "@rolldown/binding-linux-x64-musl": "^1.2.0",
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.7.7",
    "date-fns": "^4.4.0",
    "framer-motion": "^11.5.0",
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.81.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.4.0",
    "@typescript-eslint/parser": "^8.4.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.11",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "prettier": "^3.3.3",
    "typescript": "~5.5.4",
    "vite": "^5.4.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
