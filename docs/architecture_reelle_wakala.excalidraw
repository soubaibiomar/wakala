    {
      "id": "elem_0270_7481",
      "type": "text",
      "x": 1296,
      "y": 2700,
      "width": 501.11999999999995,
      "height": 81.0,
      "angle": 0,
      "strokeColor": "#f9fafb",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
