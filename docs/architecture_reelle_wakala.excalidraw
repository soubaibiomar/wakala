    {
      "id": "elem_0264_4426",
      "type": "text",
      "x": 96,
      "y": 2700,
      "width": 494.1599999999999,
      "height": 97.2,
      "angle": 0,
      "strokeColor": "#f9fafb",
      "backgroundColor": "transparent",
