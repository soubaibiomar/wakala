    },
    {
      "id": "316a1575-4eff-460c-9dd9-aa4d3ee1fa0f",
      "type": "text",
      "x": 820,
      "y": 7482,
      "width": 423.5837707519531,
      "height": 160,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 893440,
      "version": 3,
      "versionNonce": 2039538817,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785763404005,
      "link": null,
      "locked": false,
      "text": "L'armoire classique (PostgreSQL) ne comprend pas les\nphrases humaines. Qdrant transforme le texte en\nmathematiques (vecteurs).\n\nC'est lui qui comprend : \"SUV spacieux pour la ville\".\nIl donne la memoire et l'intelligence au Chatbot.\n\nMot-cle : COMPREHENSION HUMAINE",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "L'armoire classique (PostgreSQL) ne comprend pas les\nphrases humaines. Qdrant transforme le texte en\nmathematiques (vecteurs).\n\nC'est lui qui comprend : \"SUV spacieux pour la ville\".\nIl donne la memoire et l'intelligence au Chatbot.\n\nMot-cle : COMPREHENSION HUMAINE",
      "frameId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b9d"
    },
