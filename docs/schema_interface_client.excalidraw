    {
      "id": "nlp2_body",
      "type": "text",
      "x": 1527.6905525672696,
      "y": 1054.186317496673,
      "width": 498.9557030867977,
      "height": 250.24784491236002,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 156815,
      "version": 445,
      "versionNonce": 1823050031,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785766586248,
      "link": null,
      "locked": false,
      "text": "content_based.py -> Feature Vector (7 dimensions)\n  FEATURE_COLUMNS = [\n    price_norm, year_norm, mileage_norm,\n    body_type_encoded, transmission_encoded,\n    fuel_encoded, engine_power_norm\n  ]\n  Encodage ordinal: BODY_TYPE_ORDER (9 categories)\n  TRANSMISSION_MAP: manuelle=0, semi_auto=0.5, auto=1\n  FUEL_ORDER: essence->diesel->hybride->...->hydrogene\n\nembeddings.py -> Sentence Transformers\n  Modele: all-MiniLM-L6-v2 (384 dimensions)\n  Input: titre + description concatenes",
      "fontSize": 15.399867379222151,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "content_based.py -> Feature Vector (7 dimensions)\n  FEATURE_COLUMNS = [\n    price_norm, year_norm, mileage_norm,\n    body_type_encoded, transmission_encoded,\n    fuel_encoded, engine_power_norm\n  ]\n  Encodage ordinal: BODY_TYPE_ORDER (9 categories)\n  TRANSMISSION_MAP: manuelle=0, semi_auto=0.5, auto=1\n  FUEL_ORDER: essence->diesel->hybride->...->hydrogene\n\nembeddings.py -> Sentence Transformers\n  Modele: all-MiniLM-L6-v2 (384 dimensions)\n  Input: titre + description concatenes",
      "frameId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "index": "b0F"
