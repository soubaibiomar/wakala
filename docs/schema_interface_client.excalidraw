      "versionNonce": 59253985,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785766666446,
      "link": null,
      "locked": false,
      "text": "_make_soup(html) -> BeautifulSoup\n  Cree un parser HTML5 a partir du HTML brut\n\n_absolute_url(href) -> str\n  Convertit les liens relatifs en URLs absolues\n\n_extract_text(soup, selectors[], default) -> str\n  Essaie N selecteurs CSS, retourne le 1er match\n\n_extract_images(soup, selectors[]) -> list[str]\n  Cherche src, data-src, data-lazy-src, deduplique\n\n_build_raw_listing(titre, prix, ...) -> dict\n  Construit le schema de sortie standardise",
      "fontSize": 12.681569933273492,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "_make_soup(html) -> BeautifulSoup\n  Cree un parser HTML5 a partir du HTML brut\n\n_absolute_url(href) -> str\n  Convertit les liens relatifs en URLs absolues\n\n_extract_text(soup, selectors[], default) -> str\n  Essaie N selecteurs CSS, retourne le 1er match\n\n_extract_images(soup, selectors[]) -> list[str]\n  Cherche src, data-src, data-lazy-src, deduplique\n\n_build_raw_listing(titre, prix, ...) -> dict\n  Construit le schema de sortie standardise",
      "frameId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "as"
    },
