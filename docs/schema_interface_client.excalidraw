    {
      "id": "nlp_body",
      "type": "text",
      "x": -6.728771394164141,
      "y": 1092.1487473452662,
      "width": 486.35603426380464,
      "height": 202.64834760991857,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 443107,
      "version": 94,
      "versionNonce": 2059437025,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785766460423,
      "link": null,
      "locked": false,
      "text": "Extraction d'entites depuis le texte brut:\n\nextract_brand(text)  -> Regex sur 30+ marques\n  'renault'->Renault, 'vw'->Volkswagen, 'mercedes'->Mercedes-Benz\n\nextract_fuel_type(text) -> Multilingue (FR+Darija)\n  'mazot'->diesel, 'lisans'->essence, 'ev'->electrique\n\nextract_body_type(text) -> Inclut Darija\n  'sghira'->citadine, 'kbira'->SUV, '3aila'->monospace\n\nPRICE_PATTERNS (5 regex) -> Budget min/max\nYEAR_PATTERNS (4 regex) -> Annee min/max",
      "fontSize": 12.47066754522576,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "Extraction d'entites depuis le texte brut:\n\nextract_brand(text)  -> Regex sur 30+ marques\n  'renault'->Renault, 'vw'->Volkswagen, 'mercedes'->Mercedes-Benz\n\nextract_fuel_type(text) -> Multilingue (FR+Darija)\n  'mazot'->diesel, 'lisans'->essence, 'ev'->electrique\n\nextract_body_type(text) -> Inclut Darija\n  'sghira'->citadine, 'kbira'->SUV, '3aila'->monospace\n\nPRICE_PATTERNS (5 regex) -> Budget min/max\nYEAR_PATTERNS (4 regex) -> Annee min/max",
      "frameId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b0C"
    },
