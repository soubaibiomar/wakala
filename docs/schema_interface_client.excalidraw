    {
      "id": "cl_body",
      "type": "text",
      "x": 372.8955270917677,
      "y": 828.4975509713408,
      "width": 1820.904725750067,
      "height": 114.95610642361517,
      "angle": 0,
      "strokeColor": "#495057",
