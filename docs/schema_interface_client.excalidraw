    {
      "id": "71ffa78e-321d-4932-9870-8ae47095bc99",
      "type": "text",
      "x": 1500,
      "y": 7482,
      "width": 425.11981201171875,
      "height": 160,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 938037,
      "version": 3,
      "versionNonce": 1110337391,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785763410055,
      "link": null,
      "locked": false,
      "text": "Il stocke les donnees sous forme de toile d'araignee.\nIl sait que Karim a regarde la Duster, que Nadia a\nachete une Duster et aime aussi le Tucson.\n\nIl va donc dire a Karim : \"Puisque tu aimes la Dacia,\ntu aimeras peut-etre le Tucson !\".\n\nMot-cle : RECOMMANDATIONS INTELLIGENTES",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "Il stocke les donnees sous forme de toile d'araignee.\nIl sait que Karim a regarde la Duster, que Nadia a\nachete une Duster et aime aussi le Tucson.\n\nIl va donc dire a Karim : \"Puisque tu aimes la Dacia,\ntu aimeras peut-etre le Tucson !\".\n\nMot-cle : RECOMMANDATIONS INTELLIGENTES",
      "frameId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b9g"
    },
