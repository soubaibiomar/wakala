      "versionNonce": 483550209,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785766310831,
      "link": null,
      "locked": false,
      "text": "hybrid_engine.py -> HybridEngine(alpha=0.6)\n  Formule: final_score = a x content_score + (1-a) x collaborative_score\n\n  A/B Testing: hash(user_id) mod 2\n    Variant A: a = 0.8 (Content dominant)\n    Variant B: a = 0.2 (Collaborative dominant)\n\n  Cold Start: si interactions < 3 -> content_score uniquement\n  Methodes: 'hybrid' | 'content-based' | 'cold-start'",
      "fontSize": 12.062964267820199,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "hybrid_engine.py -> HybridEngine(alpha=0.6)\n  Formule: final_score = a x content_score + (1-a) x collaborative_score\n\n  A/B Testing: hash(user_id) mod 2\n    Variant A: a = 0.8 (Content dominant)\n    Variant B: a = 0.2 (Collaborative dominant)\n\n  Cold Start: si interactions < 3 -> content_score uniquement\n  Methodes: 'hybrid' | 'content-based' | 'cold-start'",
      "frameId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b2W"
