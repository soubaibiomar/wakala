    {
      "id": "db_redis_b",
      "type": "text",
      "x": 1912.3948387967596,
      "y": 3651.0677671553267,
      "width": 405.03167163341766,
      "height": 475.9987593982473,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 957747,
      "version": 188,
      "versionNonce": 1656470337,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785763778863,
      "link": null,
      "locked": false,
      "text": "Sessions:\n  session:{user_id} -> JWT payload\n  TTL: 24h (access), 7j (refresh)\n\nCache API:\n  vehicles:page:{n}:filters:{hash}\n  TTL: 5 minutes\n  Invalidation sur POST/PATCH/DELETE\n\nRate Limiting:\n  ratelimit:{ip}:{endpoint}\n  Compteur glissant (SlowAPI)\n\nRecherches frequentes:\n  search:popular -> Top 10 requetes\n  Suggestions autocomplete\n\nConversation Memory:\n  chat:{session_id} -> derniers N tours\n  TTL: 30 minutes\n\nPort: 6379",
      "fontSize": 17.309045796299884,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "Sessions:\n  session:{user_id} -> JWT payload\n  TTL: 24h (access), 7j (refresh)\n\nCache API:\n  vehicles:page:{n}:filters:{hash}\n  TTL: 5 minutes\n  Invalidation sur POST/PATCH/DELETE\n\nRate Limiting:\n  ratelimit:{ip}:{endpoint}\n  Compteur glissant (SlowAPI)\n\nRecherches frequentes:\n  search:popular -> Top 10 requetes\n  Suggestions autocomplete\n\nConversation Memory:\n  chat:{session_id} -> derniers N tours\n  TTL: 30 minutes\n\nPort: 6379",
      "frameId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b4F"
    },
