    {
      "id": "7946e9e9-7f62-4fdf-8fbb-6c49b5eb3868",
      "type": "text",
      "x": 140,
      "y": 7482,
      "width": 444.1277160644531,
      "height": 120,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 931734,
      "version": 3,
      "versionNonce": 1043899617,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785763401356,
      "link": null,
      "locked": false,
      "text": "Imaginez un grand tableau Excel tres strict.\nOn y stocke les choses qui ne doivent jamais se perdre\nou comporter d'erreurs : comptes utilisateurs, factures,\net fiches basiques des voitures.\n\nMot-cle : SECURITE ET PRECISION",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "Imaginez un grand tableau Excel tres strict.\nOn y stocke les choses qui ne doivent jamais se perdre\nou comporter d'erreurs : comptes utilisateurs, factures,\net fiches basiques des voitures.\n\nMot-cle : SECURITE ET PRECISION",
      "frameId": null,
      "autoResize": true,
