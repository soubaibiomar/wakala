      "isDeleted": false,
      "boundElements": [],
      "updated": 1785766658905,
      "link": null,
      "locked": false,
      "text": "Attributs de classe:\n  platform_name: str    # ex: 'wandaloo', 'avito'\n  listing_type: str     # 'neuf' ou 'occasion'\n  base_url: str         # ex: 'https://www.wandaloo.com'\n\nMethodes abstraites:\n  @abstractmethod get_listing_urls(page: int) -> list[str]\n  @abstractmethod parse_listing(html: str, url: str) -> dict",
      "fontSize": 15.83055646862899,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "Attributs de classe:\n  platform_name: str    # ex: 'wandaloo', 'avito'\n  listing_type: str     # 'neuf' ou 'occasion'\n  base_url: str         # ex: 'https://www.wandaloo.com'\n\nMethodes abstraites:\n  @abstractmethod get_listing_urls(page: int) -> list[str]\n  @abstractmethod parse_listing(html: str, url: str) -> dict",
      "frameId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "ap"
    },
